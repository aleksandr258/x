# ==============================================================================
# X (Twitter) NFT Account Monitor & Telegram Alert Service
# Copy this file to .env and populate required secrets before starting.
# ==============================================================================

# --- Telegram Bot Configuration ---
# Obtain from @BotFather on Telegram
TELEGRAM_BOT_TOKEN=1234567890:REPLACE_WITH_YOUR_BOT_TOKEN

# Comma-separated list of authorized Telegram numeric Chat IDs (users or admin groups)
# Example: ADMIN_CHAT_IDS=123456789,-100987654321
ADMIN_CHAT_IDS=123456789

# --- Twitter Data Provider ---
# Set MOCK_MODE=true to run locally without an API key using deterministic mock data
MOCK_MODE=false
# When MOCK_MODE=true, set MOCK_AUTO_EVENTS=true to synthesize periodic NFT tweets & profile updates
MOCK_AUTO_EVENTS=false

# Required when MOCK_MODE=false (obtain at https://twitterapi.io)
TWITTER_API_KEY=
TWITTER_API_BASE_URL=https://api.twitterapi.io
TWITTER_HTTP_TIMEOUT_MS=15000

# Minimum delay between any two TwitterAPI.io requests (ms).
# Starter/unpaid tier limit is 1 req / 5000ms (0.2 QPS); 5500ms provides a safe margin.
TWITTER_MIN_INTERVAL_MS=5500
TWITTER_MAX_RETRIES=3

# --- Polling & Batching Configuration ---
# Tweet poll interval in seconds (minimum 15s, recommended 60s)
TWEET_POLL_INTERVAL_SEC=60
# Profile snapshot poll interval in seconds (minimum 30s, recommended 180s)
PROFILE_POLL_INTERVAL_SEC=180

# Sliding overlap buffer to prevent missed tweets due to X indexing jitter (seconds)
TWEET_OVERLAP_BUFFER_SEC=90
# First-boot lookback window when no prior poll timestamp exists (seconds)
COLD_START_LOOKBACK_SEC=300
# Hard cap on lookback window after prolonged downtime (seconds)
MAX_LOOKBACK_SEC=1800

# Batching limits for TwitterAPI.io advanced_search & batch_info_by_ids
MAX_HANDLES_PER_SEARCH_BATCH=20
MAX_SEARCH_QUERY_LENGTH=450
MAX_PAGES_PER_SEARCH_BATCH=3
MAX_USERS_PER_PROFILE_BATCH=50

# --- Persistence & Maintenance ---
SQLITE_DB_PATH=./data/monitor.db
SEEN_TWEETS_RETENTION_DAYS=7
MAINTENANCE_INTERVAL_SEC=3600

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# Set true for human-readable colorized logs in local development
LOG_PRETTY=false
