{
  "name": "x-nft-account-monitor",
  "version": "1.0.0",
  "description": "Production-grade X (Twitter) NFT Account Monitor & Telegram Alert Service",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.0.0"
  },
  "scripts": {
    "dev": "tsx watch src/index.ts",
